# Environment Variables Template
# Copy this file to .env and configure for your environment

# PAP Service Base URL
# Development: http://localhost:3004
# Staging: https://pap-staging.yourdomain.com  
# Production: https://pap.yourdomain.com
VITE_PAP_SERVICE_URL=http://localhost:3004

# OPA Server Endpoint for Lambda Backend
# Development: http://localhost:8181
# Staging: https://opa-staging.yourdomain.com
# Production: https://opa.yourdomain.com
OPA_ENDPOINT=http://localhost:8181

# Optional: WebSocket URL (if different from PAP service)
# VITE_WEBSOCKET_URL=ws://localhost:3004
