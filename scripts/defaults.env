# OPA PBAC POC Environment Configuration
# This file defines environment variables for all services

# =============================================================================
# SERVICE PORTS
# =============================================================================
OPA_PORT=8181
PREFERENCES_PORT=3002
SWAGGER_UI_PORT=3003
PAP_SERVICE_PORT=3004
SAM_API_PORT=3000
SAM_LAMBDA_PORT=3001

# =============================================================================
# SERVICE URLS - LOCALHOST (for host machine access)
# =============================================================================
OPA_URL_LOCALHOST=http://localhost:8181
PREFERENCES_URL_LOCALHOST=http://localhost:3002
PAP_SERVICE_URL_LOCALHOST=http://localhost:3004
SAM_API_URL_LOCALHOST=http://localhost:3000
SAM_LAMBDA_URL_LOCALHOST=http://localhost:3001

# =============================================================================
# SERVICE URLS - DOCKER INTERNAL (for container-to-container communication)
# =============================================================================
OPA_URL_DOCKER=http://opa:8181
PREFERENCES_URL_DOCKER=http://preferences-service:3002
PAP_SERVICE_URL_DOCKER=http://pap-service:3004
SAM_API_URL_DOCKER=http://host.docker.internal:3000
SAM_LAMBDA_URL_DOCKER=http://host.docker.internal:3001

# =============================================================================
# ENVIRONMENT DETECTION
# =============================================================================
NODE_ENV=development
DOCKER_ENV=false

# =============================================================================
# OPA CONFIGURATION
# =============================================================================
OPA_CONTAINER_NAME=opa-pbac-poc-opa-1
OPA_LOG_LEVEL=info
OPA_DECISION_LOGS_ENABLED=true

# =============================================================================
# PAP SERVICE CONFIGURATION
# =============================================================================
PAP_DEV_MODE=false
PAP_AUTO_REFRESH=true
PAP_SOCKET_ENABLED=true

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
VITE_PAP_SERVICE_URL=http://localhost:3004
VITE_OPA_ENDPOINT=http://localhost:8181
VITE_PREFERENCES_ENDPOINT=http://localhost:3002

# =============================================================================
# LAMBDA CONFIGURATION
# =============================================================================
JWT_SECRET=your-secret-key
LAMBDA_TIMEOUT=30000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true
